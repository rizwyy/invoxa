# Default: local Nuxt API, local accounts, files in .data. No AWS calls.
NUXT_PUBLIC_APP_MODE=local
# Optional absolute directory for local-only data.
# INVOXA_DATA_DIR=/absolute/path/to/private/invoxa-data

# AWS frontend: replace these after creating resources. No secrets go in NUXT_PUBLIC_*.
# NUXT_PUBLIC_APP_MODE=aws
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_COGNITO_DOMAIN=
NUXT_PUBLIC_COGNITO_CLIENT_ID=

# Lambda environment variables (set on AWS, not in browser config)
# AWS_REGION=ap-south-1
# INVOXA_TABLE=invoxa-dev
# INVOXA_BUCKET=your-private-invoxa-bucket
# COGNITO_USER_POOL_ID=ap-south-1_example
# COGNITO_CLIENT_ID=example
# TEXTRACT_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:ACCOUNT:invoxa-extraction
# TEXTRACT_SNS_ROLE_ARN=arn:aws:iam::ACCOUNT:role/invoxa-textract-publish
# SES_FROM_EMAIL=verified-sender@example.com
